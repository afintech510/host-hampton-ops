# ── Brevo reconciliation artifacts (contain PII — never commit) ──
brevo-reconciliation-*.md
brevo-missing-optins.csv
services/website/_recon*.mjs
services/website/_recon_out.json

# ── Quo contact-import / one-off export artifacts (contain PII — never commit) ──
quo-contacts-import.csv
services/website/_quo_export.mjs
services/website/_brevo*.mjs
services/website/_count*.mjs

# ── Contact / outreach lists (customer PII — never commit) ──
# These sat untracked-but-committable; one `git add -A` would have published them.
*contacts*.csv
contacts_real.csv
my_contacts.csv
hh-scraped-contacts.csv
new-b2b-contacts.csv
new-outreach-contacts.csv
marketing-seed.md

# ── Local analysis scratch (receipts, ledger dumps, DB exports — PII) ──
# This directory holds one-off exports taken straight out of the live database.
# It was untracked-but-committable, which is not the same thing as ignored: the
# summer_hair_bookings export (16 people's names, emails and phone numbers) was
# written here on the understanding it could never be committed, and one
# `git add -A` would have published it along with everything else already in
# here. Ignored explicitly now, so the assumption is enforced rather than held.
audit_scratch/

# Google OAuth client downloads (contain client_secret)
client_secret_*.json
*.apps.googleusercontent.com.json

# Vendored third-party agent skills (installed via `npx skills add`).
# The skills themselves are upstream code, re-installable and versioned there —
# but .agents/product-marketing.md IS ours and is tracked deliberately.
.agents/skills/
